########################################################################################
# spotify json data
########################################################################################
# data requested from spotify
spotify_files <-
data.frame(file_name=list.files(getwd())) %>%
filter(grepl("Streaming_History",file_name))
spotify_raw <-
read_json(spotify_files$file_name[1],simplifyVector=T)
for(i in 2:dim(spotify_files)[1]){
temp_df <-
read_json(spotify_files$file_name[i],simplifyVector=T)
spotify_raw <-
bind_rows(spotify_raw,temp_df) %>%
filter(is.na(episode_name))  # remove podcasts
}
rm(spotify_files)
########################################################################################
#
# analysis
#
########################################################################################
########################################################################################
# clean spotify data
########################################################################################
spotify <-
spotify_raw %>%
select(artist=master_metadata_album_artist_name,
album=master_metadata_album_album_name,
track=master_metadata_track_name,
ts) %>%
mutate(date=as.Date(substr(ts,1,10)),
time_utc=substr(ts,nchar(ts)-8,nchar(ts)-4)) %>%
select(-ts) %>%
filter(!is.na(artist))  # sadly about 2878 NA values; tracks removed from spotify? would never happen w last fm...
########################################################################################
# merge
########################################################################################
# notes: last fm contains tracks earlier and later than spotify
# reason: tracks played since the spotify data pull
# tracks played before spotify was used (via last fm browser)
music <-
bind_rows(
spotify,
last_fm %>% filter(date>max(spotify$date,na.rm=T) | date<min(spotify$date,na.rm=T))
) %>%
arrange(desc(date))
write_csv(music,"music_history_complete.csv")
########################################################################################
# summarize data
########################################################################################
# top artists
artists <-
music %>%
filter(year(date)==2026) %>%
group_by(artist) %>%
summarize(num_plays=n()) %>%
ungroup() %>%
arrange(desc(num_plays)) %>%
head(20)
# top albums
albums <-
music %>%
group_by(artist,album) %>%
summarize(num_plays=n()) %>%
ungroup() %>%
arrange(desc(num_plays)) %>%
head(20) %>%
mutate(artist_album=paste0(artist," - ",album))
# songs by year
years <-
music %>%
group_by(lubridate::year(date)) %>%
summarize(num_plays=n()) %>%
ungroup() %>%
set_names("year","num_plays")
########################################################################################
#
# figures
#
########################################################################################
########################################################################################
# colors
########################################################################################
rffblue <- "#88C4F4"
rffred <- "#FF6663"
rffgreen <- "#50B161"
rffbrown <- "#74645E"
rffblack <- "#04273C"
rffpurple <- "#755EA6"
rffyellow <- "#EAD367"
rfforange <- "#F4A25F"
########################################################################################
# figures
########################################################################################
ggplot(data=artists) +
geom_bar(aes(y=reorder(artist,num_plays),x=num_plays),stat="identity",fill=rffblue) +
geom_text(aes(y=reorder(artist,num_plays),x=num_plays,label=num_plays),size=3,hjust=-0.2) +
scale_x_continuous(breaks=seq(0,1500,500),labels=seq(0,1500,500),limits=c(0,1500)) +
labs(x="",y="",title="Top artists") +
theme_minimal() +
theme(plot.background=element_rect(color="white",fill="white"),
panel.grid=element_blank(),
plot.title.position="plot",
plot.title=element_text(hjust=0.5))
ggplot(data=artists) +
geom_bar(aes(y=reorder(artist,num_plays),x=num_plays),stat="identity",fill=rffblue) +
geom_text(aes(y=reorder(artist,num_plays),x=num_plays,label=num_plays),size=3,hjust=-0.2) +
# scale_x_continuous(breaks=seq(0,1500,500),labels=seq(0,1500,500),limits=c(0,1500)) +
labs(x="",y="",title="Top artists") +
theme_minimal() +
theme(plot.background=element_rect(color="white",fill="white"),
panel.grid=element_blank(),
plot.title.position="plot",
plot.title=element_text(hjust=0.5))
# load or install necessary libraries.
if (!require("pacman")) install.packages("pacman")
pacman::p_load(
jsonlite,  #
measurements,  # convert units easily
progress,  # progress bar
scales, # add commas long numbers
tidyverse # tidyverse
)
# clear environment and set wd.
rm(list=ls(all=TRUE)); gc()
setwd(dirname(rstudioapi::getActiveDocumentContext()$path))  # should set the working directory to repo main folder
options(scipen=999)  # turn off sci notation
options(dplyr.summarise.inform = FALSE)  # turn off dplyr group by comments
`%ni%` <- Negate(`%in%`)  # "not in" function
########################################################################################
#
# read data
#
########################################################################################
########################################################################################
# existing last fm scrobbles
########################################################################################
# from "Last FM to CSV" service: https://benjaminbenben.com/lastfm-to-csv
# can update that file in the directory at any time and this script will work
last_fm <-
# read_csv("last_fm_scrobbles.csv") %>%
read_csv("keystonejesus_2025-2026.csv") %>%
set_names("artist","album","track","timestamp") %>%
mutate(day=as.numeric(substr(timestamp,1,2)),
month_name=substr(timestamp,4,6),
year=as.numeric(substr(timestamp,8,11)),
time_utc=substr(timestamp,nchar(timestamp)-4,nchar(timestamp))) %>%
left_join(data.frame(month_name=month.abb,month=1:12),by="month_name") %>%
mutate(date=as.Date(paste0(year,"-",month,"-",day))) %>%
select(artist,album,track,date,time_utc)
